{
  "profile_version": 1,
  "name": "SFX Default",
  "rules": {
    "naming_pattern": "SFX_[A-Za-z0-9]+(?:_[A-Za-z0-9]+)*_[0-9]{2}\\.[wW][aA][vV]",
    "sample_rate": 48000,
    "bit_depths": [
      16,
      24
    ],
    "channels": [
      1,
      2
    ],
    "min_duration_seconds": 0.05
  },
  "naming": {
    "prefixes": [
      "SFX"
    ],
    "capitalization": "flexible",
    "variation_digits": 2
  }
}
